# Vercel Backend Environment Variables

# 1. Razorpay Keys
# Get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_here"
RAZORPAY_KEY_SECRET="your_secret_here"
# Expose the Key ID to Vite frontend
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_here"

# 2. Firebase Admin SDK JSON
# Go to Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Copy the ENTIRE contents of the downloaded .json file and paste it here on ONE LINE.
# (If using Vercel Dashboard, just paste the raw JSON into the environment variable field).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
