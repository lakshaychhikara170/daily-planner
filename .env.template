# ==========================================
# EXECUTE PRO - ENVIRONMENT VARIABLES
# ==========================================
# 1. Rename this file to `.env.local`
# 2. Fill in the values below from your Firebase and PayPal dashboards
# 3. DO NOT share or commit your `.env.local` file anywhere!
# ==========================================

# ------------------------------------------
# FIREBASE CONFIGURATION
# Find this in Firebase Console > Project Settings > General > Web App
# ------------------------------------------
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ------------------------------------------
# PAYPAL CONFIGURATION
# Find this in PayPal Developer Dashboard > Apps & Credentials
# Use your Sandbox Client ID for testing, replace with Live when ready.
# ------------------------------------------
VITE_PAYPAL_CLIENT_ID="your-paypal-client-id"

# ------------------------------------------
# SECURE BACKEND VERIFICATION (Server-side only)
# Find this in Firebase Console > Project Settings > Service Accounts > Generate new private key
# Open the downloaded JSON file and paste the specific values here.
# NOTE: Vercel serverless functions require these to run the `firebase-admin` SDK securely.
# ------------------------------------------
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
